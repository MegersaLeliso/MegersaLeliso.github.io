---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import portrait from '../assets/portfolio.png';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const skills = [
  { label: 'Languages', items: ['Java', 'JavaScript (Node.js)', 'SQL'] },
  { label: 'Web', items: ['Express.js', 'EJS', 'REST APIs', 'HTML / CSS', 'Three.js', 'MapLibre GL JS'] },
  { label: 'Data', items: ['PostgreSQL', 'Open-Meteo API'] },
  { label: 'Practice', items: ['Object-oriented design', 'Git / GitHub', 'Claude Code CLI'] },
];
---

<Base>
  <section class="flex flex-col-reverse gap-10 sm:flex-row sm:items-start">
    <div class="flex-1">
      <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-muted">About Me</p>
      <h1 class="mt-3 text-[34px] font-semibold leading-[1.15] tracking-tight sm:text-[40px]">
        Hi, I'm Megersa.
      </h1>
      <div class="mt-6 space-y-4 text-[16.5px] leading-[1.75] text-ink/90">
        <p>
          I'm a Computer Science student at <strong class="font-semibold">Vassar College</strong>, minoring in
          Mathematics. I build software end to end — from the server that talks to an external API to the
          interface someone actually uses.
        </p>
        <p>
          Recently that has meant a full-stack weather dashboard in Node.js and a zero-framework vehicle rental
          system in Java. Outside of code, I'm Chief Product Officer at Stooping Club, a student-run free online
          chain store in Addis Ababa.
        </p>
      </div>
      <p class="mt-6 text-[14px] text-muted">Poughkeepsie, NY · English, Amharic, Afan Oromo</p>
    </div>
    <Image
      src={portrait}
      alt="Portrait of Megersa Leliso"
      width={440}
      class="w-44 shrink-0 rounded-lg sm:w-52"
      loading="eager"
      fetchpriority="high"
    />
  </section>

  <section class="mt-20">
    <h2 class="border-b border-rule pb-3 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">Selected Work</h2>
    <ul class="divide-y divide-rule">
      {projects.map((p) => (
        <li>
          <a href={`/projects/${p.id}/`} class="group flex flex-col gap-5 py-7 sm:flex-row sm:items-center">
            <Image src={p.data.cover} alt={p.data.coverAlt} width={480} class="aspect-[16/10] w-full rounded-md border border-rule object-cover object-top sm:w-56" />
            <div class="flex-1">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted">{p.data.category}</p>
              <h3 class="mt-1.5 text-[19px] font-semibold tracking-tight group-hover:underline group-hover:underline-offset-4">{p.data.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-ink/80">{p.data.summary}</p>
              <p class="mt-3 text-[13px] text-muted">{p.data.timeline}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="leadership" class="mt-16 scroll-mt-24">
    <h2 class="border-b border-rule pb-3 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">Leadership</h2>
    <div class="mt-6">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
        <h3 class="text-[19px] font-semibold tracking-tight">Office of International Services — Apprentice</h3>
        <p class="text-[13px] text-muted">Oct 2026 – Present</p>
      </div>
      <p class="mt-1 text-[14px] text-muted">Vassar College</p>
      <p class="mt-4 text-[16px] leading-[1.75] text-ink/90">
        Co-organize campus-wide events for Vassar's international community, including
        <strong class="font-semibold">Kaleidoscope</strong>, which brings together 200+ communities.
      </p>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="border-b border-rule pb-3 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">Skills</h2>
    <dl class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-[120px_1fr]">
      {skills.map((s) => (
        <>
          <dt class="text-[14px] font-semibold">{s.label}</dt>
          <dd class="-mt-3 text-[15px] text-ink/80 sm:mt-0">{s.items.join(' · ')}</dd>
        </>
      ))}
    </dl>
  </section>

  <section class="mt-16">
    <h2 class="border-b border-rule pb-3 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">Education</h2>
    <div class="mt-6 flex flex-wrap items-baseline justify-between gap-x-4">
      <h3 class="text-[17px] font-semibold">Vassar College</h3>
      <p class="text-[13px] text-muted">Poughkeepsie, NY</p>
    </div>
    <p class="mt-1 text-[15px] text-ink/80">B.A. Computer Science, Minor in Mathematics</p>
  </section>
</Base>
