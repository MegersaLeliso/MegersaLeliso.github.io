---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<Base title={data.title} description={data.summary}>
  <article>
    <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-muted">{data.category}</p>
    <h1 class="mt-3 text-[34px] font-semibold leading-[1.15] tracking-tight sm:text-[40px]">{data.title}</h1>
    <p class="mt-5 text-[18px] leading-[1.65] text-ink/80">{data.summary}</p>

    <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-y border-rule py-6 text-[14px] sm:grid-cols-3">
      <div>
        <dt class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted">Role</dt>
        <dd class="mt-1.5">{data.role}</dd>
      </div>
      <div>
        <dt class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted">Timeline</dt>
        <dd class="mt-1.5">{data.timeline}</dd>
      </div>
      <div class="col-span-2 sm:col-span-1">
        <dt class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted">Stack</dt>
        <dd class="mt-1.5">{data.stack.join(', ')}</dd>
      </div>
      {data.links.length > 0 && (
        <div class="col-span-2 sm:col-span-3">
          <dt class="sr-only">Links</dt>
          <dd class="flex flex-wrap gap-x-6 gap-y-2">
            {data.links.map((l) => (
              <a href={l.href} class="font-medium text-accent underline decoration-1 underline-offset-4 hover:text-ink">{l.label} ↗</a>
            ))}
          </dd>
        </div>
      )}
    </dl>

    <Image src={data.cover} alt={data.coverAlt} width={1520} class="mt-10 w-full rounded-lg border border-rule" loading="eager" />

    <div data-zoomable class="prose prose-neutral mt-4 max-w-none prose-headings:font-semibold prose-h2:text-[24px] prose-h3:text-[18px] prose-p:leading-[1.75] prose-li:my-1">
      <Content />
    </div>
  </article>

  {next.id !== project.id && (
    <nav class="mt-20 border-t border-rule pt-8" aria-label="Next project">
      <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted">Next project</p>
      <a href={`/projects/${next.id}/`} class="mt-2 inline-block text-[20px] font-semibold tracking-tight hover:underline hover:underline-offset-4">{next.data.title} →</a>
    </nav>
  )}
</Base>

<script>
  // Let readers open diagrams and screenshots at full resolution.
  document.querySelectorAll<HTMLImageElement>('[data-zoomable] img').forEach((img) => {
    if (img.closest('a')) return;
    const link = document.createElement('a');
    link.href = img.currentSrc || img.src;
    link.target = '_blank';
    link.rel = 'noopener';
    link.title = 'Open full size';
    img.replaceWith(link);
    link.appendChild(img);
    img.classList.add('cursor-zoom-in');
  });
</script>
