---
import Base from '../layouts/Base.astro';
import { site } from '../data/nav';

const channels = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { label: 'GitHub', value: 'github.com/MegersaLeliso', href: site.github },
  { label: 'LinkedIn', value: 'linkedin.com/in/megersa-leliso', href: site.linkedin },
];
---

<Base title="Contact" description="Get in touch with Megersa Leliso.">
  <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-muted">Contact</p>
  <h1 class="mt-3 text-[34px] font-semibold leading-[1.15] tracking-tight sm:text-[40px]">Let's talk.</h1>
  <p class="mt-6 max-w-[560px] text-[16.5px] leading-[1.75] text-ink/90">
    I'm open to internships, research, and collaborations in software engineering and product. Email is the
    fastest way to reach me.
  </p>

  <dl class="mt-12 divide-y divide-rule border-y border-rule">
    {channels.map((c) => (
      <div class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-8">
        <dt class="w-28 shrink-0 text-[12px] font-semibold uppercase tracking-[0.14em] text-muted">{c.label}</dt>
        <dd>
          <a href={c.href} class="break-all text-[17px] underline decoration-rule decoration-1 underline-offset-4 hover:decoration-ink">{c.value}</a>
        </dd>
      </div>
    ))}
  </dl>

  <p class="mt-8 text-[14px] text-muted">Based in Poughkeepsie, NY.</p>
</Base>
